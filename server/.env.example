# Howdy Radio Server Environment Variables

PORT=3000
NODE_ENV=development
AUTH_JWT_SECRET=replace-with-your-jwt-secret

# Slack integration (leave empty for mock mode)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# YouTube Data API v3 (leave empty for mock mode)
YOUTUBE_API_KEY=
HOWDY_YOUTUBE_CHANNEL_ID=

# Playlist configuration
ADS_COUNT=3

# Maximum track duration in seconds. Tracks longer than this are excluded
# from the playlist during Slack extraction (prevents DJ sets, livestreams,
# etc. from monopolizing playback). Does NOT apply to ads (already capped at 60s).
# Default: 720 (12 minutes)
MAX_TRACK_DURATION_SECONDS=720

# Reconnection grace period in minutes (default: 5)
RECONNECT_GRACE_PERIOD_MINUTES=5

# Authentication provider: stub, slack, or google (default: stub)
AUTH_PROVIDER=stub
